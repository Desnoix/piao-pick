# 数据库
DB_PATH=data/piao_pick.db

# 数据源
TUSHARE_TOKEN=

# 调度
SCHEDULE_ENABLED=true
SCHEDULE_TIME=15:30
MAX_WORKERS=4

# 选股
SELECTION_MAX_STOCKS=30
STRATEGIES_DIR=strategies

# 日志
LOG_DIR=logs
LOG_LEVEL=INFO

# 缓存
CACHE_L1_ENABLED=true
CACHE_L2_ENABLED=true
CACHE_L3_ENABLED=false
CACHE_L2_DIR=./cache
CACHE_REDIS_URL=redis://localhost:6379/0
CACHE_L1_MAXSIZE=500
CACHE_L1_TTL_SECONDS=300
CACHE_L1_CONFIG_TTL_SECONDS=3600
CACHE_L2_TTL_HOURS=24
